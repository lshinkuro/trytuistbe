# Salin ke /opt/trytuist/.env.prod di server, isi, lalu: chmod 600 .env.prod
# File ini = "secret store" di VPS. JANGAN di-commit. Buat nilai acak: openssl rand -hex 32

# --- dipakai docker compose ---
# diganti otomatis oleh deploy.sh ke tag commit
API_IMAGE=ghcr.io/lshinkuro/trytuistbe:latest
API_DOMAIN=api.trytuist.com
POSTGRES_USER=trytuist
POSTGRES_PASSWORD=GANTI_openssl_rand_hex_32
POSTGRES_DB=trytuist

# --- dibaca API (internal/config) ---
APP_ENV=prod
PORT=8080
DATABASE_URL=postgres://trytuist:GANTI_SAMA_DENGAN_POSTGRES_PASSWORD@db:5432/trytuist?sslmode=disable
# sama dengan API_KEY di scheme iOS TryTuist-Prod
API_KEYS=GANTI_openssl_rand_hex_24
# minimal 32 karakter; mengganti = semua user logout
JWT_SECRET=GANTI_openssl_rand_hex_64
LOG_LEVEL=info
GOOGLE_CLIENT_IDS=
# Mid-server-… (produksi) / SB-Mid-server-… (sandbox)
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
# webhook Midtrans: https://<domain>/v1/payments/midtrans/notification
PUBLIC_BASE_URL=https://api.trytuist.com
PAYMENT_EXPIRY=15m
COD_ENABLED=true
APNS_KEY_ID=
APNS_TEAM_ID=
# /secrets/AuthKey_XXXX.p8 (taruh file di /opt/trytuist/secrets)
APNS_KEY_FILE=

# --- backup.sh ---
BACKUP_DIR=/opt/trytuist/backups
BACKUP_KEEP_DAYS=14
# mis. r2:trytuist-backup (opsional, butuh rclone config)
BACKUP_RCLONE_REMOTE=
