APP_ENV=dev                       # dev | staging | prod
PORT=8080
DATABASE_URL=postgres://trytuist:trytuist@localhost:5432/trytuist?sslmode=disable
API_KEYS=dev-local-api-key        # dipisah koma; dicocokkan dengan header X-API-Key
JWT_SECRET=ganti-dengan-random-64-byte
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h              # 30 hari
LOG_LEVEL=debug                   # debug (dev) | info (staging/prod)

# Opsional
TIMEZONE=Asia/Jakarta             # zona waktu timestamp di response & nomor order
DELIVERY_FEE=10000                # ongkir flat (Rupiah)
FREE_DELIVERY_MIN_SUBTOTAL=0      # mis. 50000 untuk gratis ongkir ≥ Rp 50.000 (0 = nonaktif)
LOGIN_RATE_LIMIT=5                # percobaan login / menit / IP + email
WRITE_RATE_LIMIT=60               # request yang mengubah data / menit / user (0 = tanpa batas)
CHECKOUT_RATE_LIMIT=10            # POST /v1/checkout & /v1/orders / menit / user
AUTH_RATE_LIMIT=10                # daftar & refresh token / menit / IP
# LOG_FORMAT=json                 # di dev default-nya teks biasa; set json untuk format JSON

# Google Sign-In (opsional). Client ID iOS dari Google Cloud Console, dipisah koma bila lebih dari satu
# (mis. Dev & Prod). Kosong = POST /v1/auth/google membalas 503 GOOGLE_SIGN_IN_DISABLED.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com

# Pembayaran online Midtrans Snap (API_PLAN.md §5.27). Kosong = "Bayar Online" nonaktif,
# checkout memakai alur lama (pesanan langsung dibuat).
# Server key: Dashboard sandbox → Settings → Access Keys. JANGAN dipakai di iOS / web admin.
# MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
# MIDTRANS_ENABLED_PAYMENTS=gopay,shopeepay,other_qris,bca_va,bni_va,bri_va,credit_card   # kosong = semua channel aktif
PAYMENT_EXPIRY=15m                # batas waktu bayar
# URL publik backend: finish URL Snap. Webhook Midtrans tidak bisa ke localhost → pakai tunnel, mis.
#   cloudflared tunnel --url http://localhost:8080
# lalu isi Payment Notification URL di dashboard: https://<tunnel>/v1/payments/midtrans/notification
PUBLIC_BASE_URL=http://localhost:8080
COD_ENABLED=true                  # false = Bayar di Tempat dimatikan (semua pesanan wajib bayar dulu)

# Notifikasi push iOS lewat APNs (API_PLAN.md §5.28). Kosong = push hanya dicatat di log.
# developer.apple.com → Certificates, IDs & Profiles → Keys → + → Apple Push Notifications service.
# APNS_KEY_ID=ABC123DEFG
# APNS_TEAM_ID=44X7PP9237
# APNS_KEY_FILE=./secrets/AuthKey_ABC123DEFG.p8   # jangan di-commit
