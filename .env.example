APP_ENV=dev                       # dev | staging | prod
PORT=8080
DATABASE_URL=postgres://trytuist:trytuist@localhost:5432/trytuist?sslmode=disable
API_KEYS=dev-local-api-key        # dipisah koma; dicocokkan dengan header X-API-Key
JWT_SECRET=ganti-dengan-random-64-byte
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h              # 30 hari
LOG_LEVEL=debug                   # debug (dev) | info (staging/prod)

# Opsional
TIMEZONE=Asia/Jakarta             # zona waktu timestamp di response & nomor order
DELIVERY_FEE=10000                # ongkir flat (Rupiah)
FREE_DELIVERY_MIN_SUBTOTAL=0      # mis. 50000 untuk gratis ongkir ≥ Rp 50.000 (0 = nonaktif)
LOGIN_RATE_LIMIT=5                # percobaan login / menit / IP + email
# LOG_FORMAT=json                 # di dev default-nya teks biasa; set json untuk format JSON

# Google Sign-In (opsional). Client ID iOS dari Google Cloud Console, dipisah koma bila lebih dari satu
# (mis. Dev & Prod). Kosong = POST /v1/auth/google membalas 503 GOOGLE_SIGN_IN_DISABLED.
# GOOGLE_CLIENT_IDS=1234567890-abc.apps.googleusercontent.com
